{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/employee",
      "destination": "/index.html"
    },
    {
      "source": "/employee/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://suredocs-backned.vercel.app/api/:path*"
    }
  ]
}
